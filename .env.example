# Copy using scripts/init-env.ps1; this generates fresh secrets in ignored .env.
# Dotenv format: NAME=value, optional surrounding quotes. No command interpolation.
DB_URL=jdbc:mysql://127.0.0.1:3306/face_attendance?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=face_attendance
DB_PASSWORD=CHANGE_ME
# Base64 of exactly 32 random bytes; do not rotate without re-encrypting existing templates.
FACE_ENCRYPTION_KEY=GENERATE_WITH_INIT_ENV
INTERNAL_API_KEY=GENERATE_WITH_INIT_ENV
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=GENERATE_WITH_INIT_ENV
ALGORITHM_URL=http://127.0.0.1:8000
COOKIE_SECURE=true
APP_ALLOWED_ORIGIN=https://localhost
SPRING_PROFILES_ACTIVE=default
MODEL_DIR=algorithm/models
INSIGHTFACE_MODEL=buffalo_l
# Optional full path to nginx.exe. Needed for production scripts/start.ps1.
NGINX_EXE=
# Optional binaries; JAVA_HOME, NODE_HOME and PATH are also recognized.
PYTHON_EXE=algorithm/.venv-runtime/Scripts/python.exe
MAVEN_EXE=mvn.cmd
PNPM_EXE=pnpm.cmd
# mysqldump/mysql executable paths for backup and restore.
MYSQLDUMP_EXE=mysqldump.exe
MYSQL_EXE=mysql.exe
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=face_attendance

